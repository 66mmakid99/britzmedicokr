---
import BaseLayout from '@layouts/BaseLayout.astro';
import SchemaOrg from '@components/aeo/SchemaOrg.astro';
import TLDRBox from '@components/aeo/TLDRBox.astro';
import FAQSection from '@components/aeo/FAQSection.astro';
import PageHero from '@components/common/PageHero.astro';
import CTASection from '@components/common/CTASection.astro';
import UpdateDate from '@components/common/UpdateDate.astro';
import RelatedContent from '@components/common/RelatedContent.astro';
import { company } from '@data/company';

const rndSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: company.name,
  url: company.url,
  knowsAbout: [
    'Toroidal Multipolar Radio Frequency',
    'Grounding-pad-free RF Energy Delivery',
    'Real-time Electrode Temperature Monitoring',
    'Dual Frequency Ultrasound (1/3MHz, 3/10MHz)',
    'Transdermal Drug Delivery (TDD)',
    'Multi-Energy Design Medical Devices',
  ],
};
---

<BaseLayout>
  <SchemaOrg schema={rndSchema} slot="head" />

  <PageHero
    title="R&D / 기술력"
    subtitle="에너지를 조합하는 구조를 재설계하는 의료기기 회사"
    breadcrumb={[
      { name: '회사소개', href: '/about' },
      { name: 'R&D / 기술력', href: '/rnd' },
    ]}
  />

  <!-- Section 1: 소개 + TLDRBox (white) -->
  <section class="bg-white py-16 md:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <p class="mb-8 text-lg leading-relaxed text-zinc-600">
        브리츠메디는 에너지를 조합하는 구조를 재설계하는 의료기기 회사입니다. 더 강한 에너지가 아닌, 에너지를 쓰는 방식의 변화로 피부 미용 의료기기의 새로운 기준을 제시합니다.
      </p>

      <TLDRBox content="브리츠메디의 기술력은 제품으로 증명됩니다. 토로이달(Toroidal) 구조 기반의 고주파 에너지 전달 기술과 실시간 온도 모니터링 안전 설계를 적용한 TORR RF, 1/3MHz·3/10MHz 듀얼 모드로 표피·진피를 나누어 관리하도록 설계된 ULBLANC이 제품화되어 있으며, 초음파·레이저·고주파를 결합하는 차세대 복합 에너지 플랫폼을 개발하고 있습니다." />
    </div>
  </section>

  <!-- Section 2: 제품화된 핵심 기술 — TORR RF (zinc-50) -->
  <section class="bg-zinc-50 py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-teal-600">Productized Technology 01 — TORR RF</p>
      <h2 class="mt-2 mb-4 text-2xl font-bold text-zinc-900 md:text-3xl">토로이달 고주파 에너지 전달 기술</h2>
      <p class="mb-10 max-w-3xl leading-relaxed text-zinc-600">
        TORR RF에는 도넛형 코일(토로이달) 구조에 기반한 고주파 에너지 전달 기술이 적용되어 있습니다.
        에너지가 전극 표면에 균일하게 분포하도록 설계된 구조로, 별도의 접지 패드 없이 시술 부위에 에너지를 전달합니다.
      </p>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {[
          {
            title: '토로이달 전극 구조',
            desc: '도넛형 코일 구조를 응용한 전극 설계로, 고주파 에너지가 전극 표면에 균일하게 분포되도록 설계되었습니다. 체표면을 균일하게 가열하는 것을 목표로 하는 TORR RF 설계 철학의 출발점입니다.',
          },
          {
            title: '무접지 패드 방식',
            desc: '별도의 접지(그라운딩) 패드를 부착하지 않는 방식으로 설계되어, 시술 준비 과정을 단순화하고 운용 편의성을 높였습니다.',
          },
          {
            title: '시술 심도 전환 설계',
            desc: '전자식 모드 전환으로 시술 목적에 따라 에너지 전달 층위를 선택하도록 설계되었습니다. 미세형·소형·대형 핸드피스와 조합하여 부위별 시술 조건을 구성합니다.',
          },
          {
            title: '실시간 온도 모니터링 · 자동 출력 차단',
            desc: '전극 표면 온도를 실시간으로 감지하고, 기준 온도에 도달하면 자동으로 출력이 차단되도록 설계되었습니다. 시술 중 온도 편차를 줄여 안정적인 시술 운영을 돕습니다.',
          },
          {
            title: '무소모품 구조',
            desc: '시술용 팁·카트리지 교체가 필요 없는 구조로 설계되었습니다(시술용 젤 사용). 도입 병원의 운영 부담을 낮추는 구조적 특징입니다.',
          },
          {
            title: 'VIBRO · MOTION 기능',
            desc: '핸드피스의 진동(Vibro)·모션 기능으로 시술 시 편의를 제공하도록 설계되었습니다.',
          },
        ].map((item) => (
          <div class="rounded-2xl border border-zinc-100 bg-white p-6 shadow-sm transition-all duration-300 hover:shadow-md">
            <h3 class="mb-3 text-lg font-bold text-zinc-900">{item.title}</h3>
            <p class="text-sm leading-relaxed text-zinc-600">{item.desc}</p>
          </div>
        ))}
      </div>
      <p class="mt-8 text-sm text-zinc-500">
        TORR RF는 미국 FDA 510(k)(K212561) 인증과 한국 식약처(MFDS) 허가를 받은 고주파 의료기기입니다.
        <a href="/products/torr-rf" class="font-semibold text-teal-600 hover:text-teal-700">제품 상세 보기 &rarr;</a>
      </p>
    </div>
  </section>

  <!-- Section 3: 제품화된 핵심 기술 — ULBLANC (white) -->
  <section class="bg-white py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-teal-600">Productized Technology 02 — ULBLANC</p>
      <h2 class="mt-2 mb-4 text-2xl font-bold text-zinc-900 md:text-3xl">듀얼 주파수 복합 에너지 기술</h2>
      <p class="mb-10 max-w-3xl leading-relaxed text-zinc-600">
        ULBLANC에는 주파수 대역을 나누어 운용하는 듀얼 모드 설계가 적용되어 있습니다.
        저주파·고주파·초음파를 하나의 플랫폼에서 운용하며, 시술 목적에 따라 모드를 선택하도록 설계되었습니다.
      </p>
      <div class="grid gap-6 md:grid-cols-3">
        {[
          {
            title: '1/3MHz · 3/10MHz 듀얼 모드',
            desc: '두 개의 주파수 모드로 피부 표피·진피 층위를 나누어 관리하도록 설계되었습니다. 한국인 얼굴형을 고려한 인체공학적 핸드피스 설계와 결합됩니다.',
          },
          {
            title: '저주파 · 고주파 · 초음파 복합 운용',
            desc: '서로 다른 에너지 소스를 하나의 장비에서 운용하는 다적응증 대응 설계로, 시술 목적에 맞는 에너지 선택이 가능합니다.',
          },
          {
            title: '경피적 약물 전달(TDD) 지원',
            desc: '에너지 기반으로 유효 성분의 경피 전달을 보조하도록 설계된 운용 모드를 지원합니다.',
          },
        ].map((item) => (
          <div class="rounded-2xl border border-zinc-100 bg-zinc-50 p-6 shadow-sm transition-all duration-300 hover:shadow-md">
            <h3 class="mb-3 text-lg font-bold text-zinc-900">{item.title}</h3>
            <p class="text-sm leading-relaxed text-zinc-600">{item.desc}</p>
          </div>
        ))}
      </div>
      <p class="mt-8 text-sm text-zinc-500">
        ULBLANC은 한국 식약처(MFDS) 인증을 받은 의료기기입니다.
        <a href="/products/ulblanc" class="font-semibold text-teal-600 hover:text-teal-700">제품 상세 보기 &rarr;</a>
      </p>
    </div>
  </section>

  <!-- Section 4: 개발 중 — 차세대 플랫폼 (zinc-50) -->
  <section class="bg-zinc-50 py-16 md:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-zinc-400">In Development</p>
      <h2 class="mt-2 mb-4 text-2xl font-bold text-zinc-900 md:text-3xl">차세대 복합 다중 에너지 플랫폼</h2>
      <p class="leading-relaxed text-zinc-600">
        브리츠메디는 초음파·레이저·고주파를 하나의 구조 안에서 결합하는 차세대 복합 에너지 플랫폼(LUMINO WAVE)을 개발하고 있습니다.
        초음파로 피부 환경을 먼저 조성한 뒤 후속 에너지를 전달하는 조합 순서 제어를 연구하며, 낮은 출력으로 균일한 에너지 전달을 구현하는 것을 목표로 합니다.
      </p>
      <p class="mt-4 rounded-xl border border-zinc-200 bg-white p-4 text-sm leading-relaxed text-zinc-500">
        LUMINO WAVE는 현재 식약처(MFDS) 인허가 절차를 진행 중인 개발 단계 제품입니다. 효능·효과에 관한 사항은 허가 완료 후 허가 범위 내에서 안내됩니다.
      </p>
    </div>
  </section>

  <!-- Section 5: 지식재산 (white) -->
  <section class="bg-white py-16 md:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-4 text-2xl font-bold text-zinc-900 md:text-3xl">지식재산</h2>
      <p class="leading-relaxed text-zinc-600">
        브리츠메디는 핵심 에너지 전달 구조에 대한 국내 특허를 등록하였으며, 관련 기술의 지식재산권 확보를 지속하고 있습니다.
        인증 현황과 함께 자세한 내용은 <a href="/certifications" class="font-semibold text-teal-600 hover:text-teal-700">인증/특허 페이지</a>에서 확인하실 수 있습니다.
      </p>
    </div>
  </section>

  <!-- Section 6: FAQ (zinc-50) -->
  <section class="bg-zinc-50 py-16 md:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <FAQSection items={[
        { question: '다중 에너지 설계(Multi-Energy Design)란 무엇인가요?', answer: '다중 에너지 설계는 고주파·초음파 등 여러 에너지를 구조적으로 조합해, 출력을 높이는 대신 에너지를 전달하는 구조 자체를 재설계하는 브리츠메디의 기술 철학입니다. TORR RF의 토로이달 전극 구조, ULBLANC의 듀얼 주파수 모드가 이 철학이 제품화된 사례입니다.' },
        { question: 'TORR RF의 토로이달 구조는 무엇이 다른가요?', answer: '도넛형 코일 구조를 응용한 전극 설계로, 고주파 에너지가 전극 표면에 균일하게 분포되도록 설계되었습니다. 별도의 접지 패드 없이 운용하는 방식이며, 전극 표면 온도를 실시간으로 감지해 기준 온도 도달 시 자동으로 출력을 차단하는 안전 설계와 결합되어 있습니다.' },
        { question: '무소모품 구조란 무슨 의미인가요?', answer: 'TORR RF는 시술용 팁이나 카트리지를 교체할 필요가 없는 구조로 설계되어 있습니다(시술용 젤은 사용). 시술 건당 소모품 비용이 발생하지 않는 구조적 특징으로, 도입 병원의 운영 부담을 낮춥니다.' },
        { question: 'LUMINO WAVE는 언제 출시되나요?', answer: 'LUMINO WAVE는 현재 식약처(MFDS) 인허가 절차를 진행 중인 개발 단계 제품입니다. 허가 완료 후 공식 채널을 통해 출시 일정을 안내드릴 예정입니다.' },
      ]} />
    </div>
  </section>

  <!-- Section 7: CTA + Related (white) -->
  <section class="bg-white py-16 md:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <CTASection title="브리츠메디의 기술을 직접 경험해 보세요" description="제품 데모 및 기술 상담을 요청하실 수 있습니다." />

      <RelatedContent items={[
        { title: 'TORR RF 제품 상세', href: '/products/torr-rf', description: '토로이달 고주파 기술이 적용된 플래그십 제품' },
        { title: '인증 및 특허', href: '/certifications', description: 'FDA·ISO·MFDS 인증 및 지식재산 현황' },
        { title: '기업소개', href: '/about', description: '브리츠메디 회사 소개' },
      ]} />

      <UpdateDate />
    </div>
  </section>
</BaseLayout>
