---
import BaseLayout from '@layouts/BaseLayout.astro';
import SchemaOrg from '@components/aeo/SchemaOrg.astro';
import UpdateDate from '@components/common/UpdateDate.astro';
import { organizationSchema } from '@lib/schema';
import { getAllPosts } from '@data/blog';

const latestPosts = (await getAllPosts()).slice(0, 4);

const products = [
  {
    id: 'torr-rf',
    name: 'TORR RF',
    nameKo: '토르 RF',
    category: 'FLAGSHIP RF DEVICE',
    tagline: '비침습 멀티웨이브 RF 스킨타이트닝 & 바디컨투어링',
    image: '/images/products/torr-rf/TORR RF2.webp',
    specs: [
      { k: 'ENERGY', v: '적은 출력, 균일한 에너지 전달' },
      { k: 'MODE', v: 'Face / Body / Eye 적용' },
      { k: 'CLEAR', v: 'FDA 510(k) 승인 획득' },
    ],
    href: '/products/torr-rf',
  },
  {
    id: 'ulblanc',
    name: 'ULBLANC',
    nameKo: '울블랑',
    category: 'PREMIUM SKINCARE',
    tagline: '저주파·고주파·초음파 다적응증 의료기기',
    image: '/images/products/ulblanc/ulblanc_fullbody.webp',
    specs: [
      { k: 'DUAL', v: '1/3MHz + 3/10MHz 듀얼 모드' },
      { k: 'MULTI', v: '저주파·고주파·초음파' },
      { k: 'TDD', v: '경피적 약물 전달' },
    ],
    href: '/products/ulblanc',
  },
  {
    id: 'lumino-wave',
    name: 'LUMINO WAVE',
    nameKo: '루미노 웨이브',
    category: 'MULTI-ENERGY DESIGN',
    tagline: '초음파 + 레이저 + 고주파 복합 다중 에너지',
    image: '/images/products/lumino-wave/luminowave-product-01.webp',
    specs: [
      { k: 'US', v: '초음파 피부 환경 제어' },
      { k: 'POWER', v: '저출력 고효율 구조' },
      { k: 'HP×2', v: '2종 핸드피스 시스템' },
    ],
    href: '/products/lumino-wave',
  },
  {
    id: 'newchae',
    name: 'NEWCHAE Shot',
    nameKo: '뉴채 샷',
    category: 'BEAUTY DEVICE',
    tagline: '고주파 타이트닝 3가지 모드 시스템',
    image: '/images/products/newchae/newchae 01 (1).webp',
    specs: [
      { k: 'MODE', v: '타이트닝 / V라인 / 스킨부스트' },
      { k: 'SHOT', v: '멀티채널 집중 에너지 샷' },
      { k: 'VIB', v: '분당 1만회 미세진동' },
    ],
    href: '/products/newchae',
  },
];

const stats = [
  { number: 40, suffix: '+', label: '파트너 국가' },
  { number: 3, suffix: '종', label: '트리플 인증' },
  { number: 20, suffix: '+', label: '특허 보유' },
  { number: 50, suffix: 'K+', label: '글로벌 시술' },
];
---

<BaseLayout>
  <Fragment slot="head">
    <SchemaOrg schema={organizationSchema()} />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,100..900&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <div id="home-immersive" class="bg-[#070708] text-[#F4F4F2]">
    <!-- ============ 1. HERO ============ -->
    <section class="hero relative flex h-[100svh] min-h-[560px] flex-col justify-end overflow-hidden">
      <div class="absolute inset-0 z-0">
        <video
          id="hero-video"
          autoplay muted loop playsinline
          class="absolute inset-0 h-full w-full object-cover"
        >
          <source src="/videos/hero.mp4" type="video/mp4" />
        </video>
        <div class="absolute inset-0 bg-gradient-to-t from-[#070708] via-[#070708]/35 to-[#070708]/60"></div>
      </div>

      <div class="hero-content relative z-10 mx-auto w-full max-w-[1400px] px-5 pb-16 sm:px-8 md:pb-20">
        <p class="font-mono text-[11px] tracking-[0.35em] text-teal-400/90 uppercase">
          Multi-Energy Architecture
        </p>
        <h1 class="mt-5">
          <span class="hero-line block font-display text-[clamp(2rem,9.5vw,9rem)] font-black uppercase leading-[0.92] tracking-[-0.01em] text-white">
            Energy,
          </span>
          <span class="hero-line block font-display text-[clamp(2rem,9.5vw,9rem)] font-black uppercase leading-[0.92] tracking-[-0.01em] text-white">
            Redesigned<span class="text-teal-400">.</span>
          </span>
          <span class="hero-sub mt-6 block max-w-2xl break-keep text-base font-normal leading-relaxed text-zinc-300 sm:text-lg">
            브리츠메디는 피부 치료 및 미용을 위한 다중 에너지 설계 의료기기 전문 기업입니다.
            더 강한 에너지가 아닌, 에너지를 쓰는 방식의 변화로 새로운 기준을 만듭니다.
          </span>
        </h1>
        <div class="hero-cta mt-9 flex flex-wrap items-center gap-3">
          <a href="/contact" class="rounded-full bg-teal-500 px-8 py-3.5 text-sm font-semibold text-[#070708] transition-colors hover:bg-teal-400">
            상담 신청
          </a>
          <a href="/products" class="rounded-full border border-white/25 px-8 py-3.5 text-sm font-semibold text-white transition-colors hover:border-white/60">
            제품 알아보기
          </a>
        </div>
      </div>

      <div class="absolute bottom-0 right-8 z-10 hidden items-center gap-3 pb-16 md:flex" aria-hidden="true">
        <span class="font-mono text-[10px] tracking-[0.3em] text-white/40 uppercase" style="writing-mode: vertical-rl;">Scroll</span>
        <span class="scroll-line block h-16 w-px bg-white/25"></span>
      </div>
    </section>

    <!-- ============ 2. MANIFESTO ============ -->
    <section class="manifesto relative px-5 py-36 sm:px-8 md:py-52" aria-label="브랜드 철학">
      <div class="mx-auto max-w-[1100px]">
        <p class="font-mono text-[11px] tracking-[0.35em] text-zinc-600 uppercase">Our Thesis</p>
        <p id="manifesto-text" class="break-keep mt-8 text-[clamp(1.75rem,4.5vw,3.75rem)] font-bold leading-[1.35] tracking-tight text-zinc-700">
          더 강한 에너지가 아닌, 에너지를 쓰는 방식을 바꿉니다. 초음파·레이저·고주파를 구조적으로 조합해 낮은 출력으로 높은 효과를 설계합니다.
        </p>
      </div>
    </section>

    <!-- ============ 3. PRODUCT DIAL (pinned showcase) ============ -->
    <section id="dial-section" class="relative" aria-label="제품 라인업">
      <div id="dial-viewport" class="relative flex min-h-[100svh] items-center overflow-hidden">

        <!-- 시그니처: 토로이달 링 다이얼 -->
        <svg id="energy-dial" class="pointer-events-none absolute -left-[28vw] top-1/2 h-[120vh] w-[120vh] -translate-y-1/2 opacity-[0.16] lg:-left-[16vw]" viewBox="0 0 800 800" fill="none" aria-hidden="true">
          {Array.from({ length: 11 }).map((_, i) => (
            <circle cx="400" cy="400" r={60 + i * 32} stroke="#5EEAD4" stroke-width={i % 3 === 0 ? 1.2 : 0.5} opacity={1 - i * 0.07} />
          ))}
          <line x1="400" y1="12" x2="400" y2="88" stroke="#5EEAD4" stroke-width="1.5" />
          <circle cx="400" cy="400" r="6" fill="#5EEAD4" />
        </svg>

        <div class="relative mx-auto w-full max-w-[1400px] px-5 sm:px-8">
          <div class="mb-4 flex items-baseline justify-between lg:mb-0">
            <h2 class="font-display text-sm font-bold uppercase tracking-[0.3em] text-zinc-500">Product Line</h2>
            <p class="font-mono text-xs text-zinc-600" aria-hidden="true">
              <span id="dial-index">01</span> / {String(products.length).padStart(2, '0')}
            </p>
          </div>

          <div id="dial-slides" class="relative">
            {products.map((p, i) => (
              <article
                class="dial-slide grid items-center gap-8 py-14 lg:absolute lg:inset-0 lg:grid-cols-2 lg:gap-16 lg:py-0"
                data-index={i}
              >
                <div class="dial-media relative flex items-center justify-center">
                  <img
                    src={p.image}
                    alt={`${p.nameKo}(${p.name}) — ${p.tagline}`}
                    width={720} height={600}
                    loading={i === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                    class="max-h-[42vh] w-auto object-contain drop-shadow-[0_30px_60px_rgba(0,0,0,0.55)] lg:max-h-[60vh]"
                  />
                </div>
                <div class="dial-copy">
                  <p class="font-mono text-[11px] tracking-[0.3em] text-teal-400/90 uppercase">{p.category}</p>
                  <h3 class="mt-4 font-display text-[clamp(2.2rem,5vw,4.5rem)] font-black uppercase leading-none tracking-tight text-white">
                    {p.name}
                  </h3>
                  <p class="mt-2 text-sm text-zinc-500">{p.nameKo}</p>
                  <p class="mt-5 max-w-md text-base leading-relaxed text-zinc-300">{p.tagline}</p>
                  <dl class="mt-8 max-w-md divide-y divide-white/10 border-y border-white/10">
                    {p.specs.map((s) => (
                      <div class="flex items-center gap-6 py-3">
                        <dt class="w-16 shrink-0 font-mono text-[11px] tracking-[0.15em] text-teal-400/80">{s.k}</dt>
                        <dd class="text-sm text-zinc-300">{s.v}</dd>
                      </div>
                    ))}
                  </dl>
                  <a href={p.href} class="group mt-8 inline-flex items-center gap-2 text-sm font-semibold text-white">
                    자세히 보기
                    <span class="inline-block h-px w-8 bg-teal-400 transition-all group-hover:w-12"></span>
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 4. TECHNOLOGY ============ -->
    <section class="tech relative overflow-hidden" aria-label="핵심 기술">
      <div class="relative flex min-h-[80svh] items-center">
        <video
          autoplay muted loop playsinline
          class="absolute inset-0 h-full w-full object-cover opacity-40"
        >
          <source src="/images/products/torr-rf/torr_rf_handpiece_3d_animation.mp4" type="video/mp4" />
        </video>
        <div class="absolute inset-0 bg-gradient-to-r from-[#070708] via-transparent to-[#070708]/70"></div>
        <div class="relative mx-auto w-full max-w-[1400px] px-5 py-28 sm:px-8">
          <p class="font-mono text-[11px] tracking-[0.35em] text-teal-400/90 uppercase">Core Technology</p>
          <h2 class="tech-title mt-5 max-w-3xl font-display text-[clamp(2.2rem,6vw,5.5rem)] font-black uppercase leading-[0.95] text-white">
            Less Power,<br />Uniform Delivery
          </h2>
          <p class="tech-sub mt-6 max-w-xl text-base leading-relaxed text-zinc-300">
            초음파·레이저·고주파를 구조적으로 조합하는 멀티 에너지 설계.
            에너지를 조합하는 구조 자체를 재설계해 낮은 출력으로도 균일한 에너지 전달을 구현합니다.
          </p>
          <a href="/rnd" class="group mt-9 inline-flex items-center gap-2 text-sm font-semibold text-white">
            R&amp;D / 기술력 보기
            <span class="inline-block h-px w-8 bg-teal-400 transition-all group-hover:w-12"></span>
          </a>
        </div>
      </div>
    </section>

    <!-- ============ 5. NUMBERS ============ -->
    <section class="numbers border-t border-white/5 px-5 py-28 sm:px-8 md:py-36" aria-label="주요 수치">
      <div class="mx-auto max-w-[1400px]">
        <p class="font-mono text-[11px] tracking-[0.35em] text-zinc-600 uppercase">Sustained Growth</p>
        <div class="mt-14 grid grid-cols-2 gap-x-6 gap-y-14 lg:grid-cols-4">
          {stats.map((s) => (
            <div class="stat">
              <p class="font-display text-[clamp(3.5rem,7vw,6.5rem)] font-black leading-none tracking-tight text-white">
                <span class="stat-number" data-target={s.number}>0</span><span class="text-[0.45em] text-teal-400">{s.suffix}</span>
              </p>
              <p class="mt-3 font-mono text-xs tracking-[0.2em] text-zinc-500 uppercase">{s.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ 6. NEWS ============ -->
    <section class="news border-t border-white/5 px-5 py-24 sm:px-8 md:py-32" aria-label="최신 소식">
      <div class="mx-auto max-w-[1400px]">
        <div class="flex items-end justify-between">
          <h2 class="font-display text-3xl font-black uppercase tracking-tight text-white md:text-5xl">News Room</h2>
          <a href="/blog" class="group inline-flex items-center gap-2 text-sm font-semibold text-zinc-400 transition-colors hover:text-white">
            더보기
            <span class="inline-block h-px w-6 bg-teal-400 transition-all group-hover:w-10"></span>
          </a>
        </div>
        <div class="mt-12 divide-y divide-white/10 border-y border-white/10">
          {latestPosts.map((post) => (
            <a href={`/blog/${post.slug}`} class="news-row group grid grid-cols-[1fr_auto] items-center gap-4 py-6 sm:grid-cols-[140px_1fr_auto]">
              <span class="hidden font-mono text-[11px] tracking-[0.15em] text-teal-400/70 uppercase sm:block">{post.categoryLabel}</span>
              <span class="text-base font-medium text-zinc-300 transition-colors group-hover:text-white md:text-lg">{post.title}</span>
              <span class="font-mono text-xs text-zinc-600">{post.publishedAt}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ 7. CTA ============ -->
    <section class="cta-final relative overflow-hidden border-t border-white/5 px-5 py-32 text-center sm:px-8 md:py-44" aria-label="상담 신청">
      <svg class="pointer-events-none absolute left-1/2 top-1/2 h-[900px] w-[900px] -translate-x-1/2 -translate-y-1/2 opacity-[0.08]" viewBox="0 0 800 800" fill="none" aria-hidden="true">
        {Array.from({ length: 8 }).map((_, i) => (
          <circle cx="400" cy="400" r={80 + i * 42} stroke="#5EEAD4" stroke-width="0.6" />
        ))}
      </svg>
      <div class="relative mx-auto max-w-3xl">
        <h2 class="font-display text-[clamp(2.5rem,7vw,6rem)] font-black uppercase leading-[0.95] text-white">
          Let's Talk<span class="text-teal-400">.</span>
        </h2>
        <p class="mt-6 text-lg text-zinc-400">함께 성장할 파트너를 찾고 있습니다</p>
        <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a href="/contact" class="rounded-full bg-teal-500 px-10 py-4 text-base font-semibold text-[#070708] transition-colors hover:bg-teal-400">
            무료 상담 신청
          </a>
          <a href="/support/partnership" class="rounded-full border border-white/25 px-10 py-4 text-base font-semibold text-white transition-colors hover:border-white/60">
            파트너십 문의
          </a>
        </div>
      </div>
    </section>

    <div class="mx-auto max-w-[1400px] px-5 pb-10 sm:px-8">
      <UpdateDate />
    </div>
  </div>
</BaseLayout>

<style>
  .font-display {
    font-family: 'Archivo', 'Pretendard Variable', sans-serif;
    font-stretch: 115%;
  }
  /* 모바일: 확장폭 축소로 대형 타이포 가로 오버플로우 방지 */
  @media (max-width: 639px) {
    .font-display {
      font-stretch: 100%;
    }
  }
  .font-mono {
    font-family: 'IBM Plex Mono', monospace;
  }
  /* manifesto 단어 span (JS 생성) */
  #manifesto-text :global(.word) {
    color: #3f3f46;
    transition: color 0.15s linear;
  }
  #manifesto-text :global(.word.lit) {
    color: #f4f4f2;
  }
  /* 데스크톱 pinned 슬라이드: JS 제어 전 첫 슬라이드만 노출 */
  @media (min-width: 1024px) {
    .dial-slide {
      opacity: 0;
      visibility: hidden;
    }
    .dial-slide[data-index='0'] {
      opacity: 1;
      visibility: visible;
    }
    #dial-slides {
      height: 80vh;
    }
  }
  /* 모션 축소 환경: 전 슬라이드 정적 노출 */
  @media (prefers-reduced-motion: reduce) {
    .dial-slide {
      position: static !important;
      opacity: 1 !important;
      visibility: visible !important;
    }
    #dial-slides {
      height: auto !important;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import Lenis from 'lenis';

  gsap.registerPlugin(ScrollTrigger);

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---------- Lenis 스무스 스크롤 ----------
  if (!reduced) {
    const lenis = new Lenis({ lerp: 0.11 });
    lenis.on('scroll', ScrollTrigger.update);
    gsap.ticker.add((time) => lenis.raf(time * 1000));
    gsap.ticker.lagSmoothing(0);
  }

  // ---------- 히어로 등장 ----------
  if (!reduced) {
    gsap.from('.hero-line', { yPercent: 60, opacity: 0, duration: 1.1, ease: 'power3.out', stagger: 0.12, delay: 0.15 });
    gsap.from('.hero-sub, .hero-cta', { y: 24, opacity: 0, duration: 0.9, ease: 'power2.out', stagger: 0.1, delay: 0.7 });
    gsap.to('.scroll-line', { scaleY: 0.3, transformOrigin: 'top', repeat: -1, yoyo: true, duration: 1.4, ease: 'power1.inOut' });
    gsap.to('.hero-content', {
      yPercent: 18,
      opacity: 0.25,
      ease: 'none',
      scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: true },
    });
  }

  // ---------- 매니페스토: 단어별 점등 ----------
  const manifesto = document.getElementById('manifesto-text');
  if (manifesto) {
    const words = (manifesto.textContent ?? '').trim().split(/\s+/);
    manifesto.innerHTML = words.map((w) => `<span class="word">${w}</span>`).join(' ');
    const spans = manifesto.querySelectorAll('.word');
    if (reduced) {
      spans.forEach((s) => s.classList.add('lit'));
    } else {
      ScrollTrigger.create({
        trigger: manifesto,
        start: 'top 75%',
        end: 'bottom 45%',
        scrub: true,
        onUpdate: (self) => {
          const n = Math.floor(self.progress * spans.length);
          spans.forEach((s, i) => s.classList.toggle('lit', i <= n));
        },
      });
    }
  }

  // ---------- 제품 다이얼 (데스크톱만 핀 고정) ----------
  const mm = gsap.matchMedia();
  mm.add('(min-width: 1024px) and (prefers-reduced-motion: no-preference)', () => {
    const slides = gsap.utils.toArray<HTMLElement>('.dial-slide');
    const dial = document.getElementById('energy-dial');
    const indexEl = document.getElementById('dial-index');
    const SEG = 1 / slides.length;

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: '#dial-section',
        start: 'top top',
        end: () => `+=${slides.length * 90}%`,
        pin: '#dial-viewport',
        scrub: 0.6,
        onUpdate: (self) => {
          const idx = Math.min(slides.length - 1, Math.floor(self.progress / SEG));
          if (indexEl) indexEl.textContent = String(idx + 1).padStart(2, '0');
        },
      },
    });

    slides.forEach((slide, i) => {
      const media = slide.querySelector('.dial-media');
      const copy = slide.querySelector('.dial-copy');
      const at = i * SEG;
      if (i > 0) {
        tl.set(slide, { visibility: 'visible' }, at);
        tl.fromTo(slide, { opacity: 0 }, { opacity: 1, duration: SEG * 0.35 }, at);
        tl.fromTo(media, { scale: 0.82, yPercent: 8 }, { scale: 1, yPercent: 0, duration: SEG * 0.5, ease: 'power2.out' }, at);
        tl.fromTo(copy, { y: 40, opacity: 0 }, { y: 0, opacity: 1, duration: SEG * 0.45, ease: 'power2.out' }, at + SEG * 0.08);
      }
      if (i < slides.length - 1) {
        tl.to(slide, { opacity: 0, duration: SEG * 0.3 }, at + SEG * 0.68);
        tl.set(slide, { visibility: 'hidden' }, at + SEG);
      }
    });

    // 다이얼 링 회전 — 슬라이드 진행과 동기
    if (dial) {
      tl.to(dial, { rotation: 270, transformOrigin: '50% 50%', ease: 'none', duration: 1 }, 0);
    }
    return () => tl.scrollTrigger?.kill();
  });

  // ---------- 모바일: 심플 리빌 ----------
  mm.add('(max-width: 1023px) and (prefers-reduced-motion: no-preference)', () => {
    gsap.utils.toArray<HTMLElement>('.dial-slide').forEach((slide) => {
      gsap.from(slide, {
        y: 40,
        opacity: 0,
        duration: 0.8,
        ease: 'power2.out',
        scrollTrigger: { trigger: slide, start: 'top 80%' },
      });
    });
  });

  // ---------- 기술 섹션 리빌 ----------
  if (!reduced) {
    gsap.from('.tech-title, .tech-sub', {
      y: 50,
      opacity: 0,
      duration: 1,
      ease: 'power3.out',
      stagger: 0.15,
      scrollTrigger: { trigger: '.tech', start: 'top 65%' },
    });
  }

  // ---------- 숫자 카운트업 ----------
  document.querySelectorAll<HTMLElement>('.stat-number').forEach((el) => {
    const target = Number(el.dataset.target ?? 0);
    if (reduced) {
      el.textContent = String(target);
      return;
    }
    gsap.fromTo(
      el,
      { innerText: 0 },
      {
        innerText: target,
        duration: 1.6,
        ease: 'power1.out',
        snap: { innerText: 1 },
        scrollTrigger: { trigger: el, start: 'top 85%' },
      }
    );
  });

  // ---------- 뉴스 행 스태거 ----------
  if (!reduced) {
    gsap.from('.news-row', {
      y: 24,
      opacity: 0,
      duration: 0.6,
      ease: 'power2.out',
      stagger: 0.08,
      scrollTrigger: { trigger: '.news', start: 'top 75%' },
    });
  }
</script>
